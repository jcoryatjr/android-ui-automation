<Window x:Class="AndroidUIAutomation.UI.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Android UI Automation" Height="400" Width="700">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock FontSize="20" FontWeight="Bold" Text="Android UI Automation" />

        <TextBox Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 Text="Use Start to run a selected instruction set from the InstructionSets folder." />

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Name="StartButton" Margin="0,8,8,0" Padding="12,6" Content="Start" Click="StartButton_OnClick"/>
            <Button Name="PauseButton" Margin="0,8,8,0" Padding="12,6" Content="Pause" Click="PauseButton_OnClick"/>
            <Button Name="ResumeButton" Margin="0,8,8,0" Padding="12,6" Content="Resume" Click="ResumeButton_OnClick"/>
            <Button Name="StopButton" Margin="0,8,0,0" Padding="12,6" Content="Stop" Click="StopButton_OnClick"/>
        </StackPanel>
    </Grid>
</Window>
